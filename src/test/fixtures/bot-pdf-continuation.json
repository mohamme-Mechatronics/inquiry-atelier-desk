{
  "nodes": {
    "Validate WhatsApp Media ID": {
      "jsCode": "// Upload sends the document immediately on Telegram; Meta only uploads media.\nconst item = $input.first();\nconst j = item.json || {};\nconst telegram = $('Build Quote HTML').first().json.phone_number_id === 'tg';\nif (telegram) {\n  const result = j.result;\n  if (j.ok !== true || !result || !Number.isInteger(result.message_id) || !result.document || !result.document.file_id) {\n    throw new Error('TELEGRAM DOCUMENT SEND FAILED: no confirmed document response.');\n  }\n  return [{ ...item, json: { ...j, id: String(result.document.file_id), messages: [{ id: 'tg:' + result.message_id }] } }];\n}\nif (!j.id) throw new Error('WHATSAPP MEDIA UPLOAD FAILED: Meta returned no media id.');\nreturn items;\n"
    },
    "Validate Quote Send Response": {
      "jsCode": "const item = $input.first();\nconst j = item.json || {};\nconst telegram = $('Build Quote HTML').first().json.phone_number_id === 'tg';\nif (telegram && (j.ok !== true || !j.result || !Number.isInteger(j.result.message_id) || !j.result.document || !j.result.document.file_id)) {\n  throw new Error('TELEGRAM DOCUMENT SEND FAILED: no confirmed document response.');\n}\nconst id = Array.isArray(j.messages) && j.messages[0] && j.messages[0].id;\nif (!id) throw new Error('DOCUMENT SEND FAILED: no message id.');\nreturn items;\n"
    },
